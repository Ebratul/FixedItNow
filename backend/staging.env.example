# Variables for docker-compose.staging.yml (a DISPOSABLE local staging stack).
# Copy to staging.env, fill with LOCAL-ONLY random values, and run:
#   docker compose -f docker-compose.staging.yml --env-file staging.env up --build
# Never reuse production secrets here and never commit staging.env (it is git-ignored).
#
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# openssl rand -base64 48   (two DIFFERENT values, >= 32 characters each)
AI_SERVICE_TOKEN=
APP_API_SERVICE_TOKEN=
POSTGRES_PASSWORD=
# Optional: leave empty to run the assistant in rule-based "simple mode"
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Copy to .env (never commit .env). All values below are PLACEHOLDERS.

NODE_ENV=development
PORT=4000

# --- Database (PostgreSQL) ---------------------------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/fixeditnow_dev
# Integration tests TRUNCATE tables. Use a disposable database whose name ends
# in _test; the test runner refuses anything else.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/fixeditnow_test

# --- Auth (Better Auth) ------------------------------------------------------
# SECRET. >= 32 random characters: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-chars
# PUBLIC origin of the web app (the web app proxies /api/v1/* to this service),
# so cookies are first-party and OAuth/email links point at the web app.
BETTER_AUTH_URL=http://localhost:3000
FRONTEND_ORIGIN=http://localhost:3000

# --- Google OAuth (optional; set both or neither) ----------------------------
# GOOGLE_CLIENT_ID is public-ish; GOOGLE_CLIENT_SECRET is SECRET.
# Redirect URI to register: <BETTER_AUTH_URL>/api/v1/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email -------------------------------------------------------------------
# development default: "console" (prints links to this terminal; refused in production)
# production: "smtp" (required)
MAIL_TRANSPORT=console
EMAIL_FROM="FixedItNow <no-reply@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
# SECRET
SMTP_USER=
SMTP_PASS=

# --- Proxy / rate limiting ---------------------------------------------------
# Reverse-proxy hops in front of this service (used for client IP).
TRUST_PROXY=1
# Optional: comma-separated proxy IPs/CIDRs for Better Auth's X-Forwarded-For walk.
TRUSTED_PROXIES=
RATE_LIMIT_ENABLED=true

# --- Payments (Step 6; all optional) -----------------------------------------
# A provider is enabled only when ALL of its credentials are set. Nothing here
# is ever sent to the browser. See docs/PAYMENTS.md for sandbox setup.
# Credentials marked SECRET must never be committed or pasted into chat.
# bKash tokenized checkout v2 (sandbox example shown; the live URL comes from bKash)
BKASH_BASE_URL=
BKASH_APP_KEY=
# SECRET
BKASH_APP_SECRET=
BKASH_USERNAME=
# SECRET
BKASH_PASSWORD=
# true only in a production deployment with live credentials
BKASH_IS_LIVE=false
# bearer | raw  (the bKash docs are ambiguous; flip if the sandbox answers 401)
BKASH_AUTH_SCHEME=bearer
BKASH_REFUNDS_ENABLED=false
# SSLCOMMERZ hosted checkout
SSLCOMMERZ_STORE_ID=
# SECRET
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_LIVE=false
SSLCOMMERZ_REFUNDS_ENABLED=false

# --- AI assistant (Step 8; optional) -----------------------------------------
# The Python service lives in ../rag_agent. The assistant is enabled only when
# ALL THREE are set; otherwise /ai/chat answers 503 and normal search is unaffected.
# Two DIFFERENT random secrets (>= 32 chars each; openssl rand -base64 48), one per direction.
# AI_SERVICE_TOKEN must equal the AI service's AI_SERVICE_TOKEN;
# APP_API_SERVICE_TOKEN must equal the AI service's APP_API_SERVICE_TOKEN.
AI_SERVICE_URL=
# SECRET (this API -> AI service)
AI_SERVICE_TOKEN=
# SECRET (AI service -> /api/v1/internal/ai/*)
APP_API_SERVICE_TOKEN=
AI_REQUEST_TIMEOUT_SECONDS=30
AI_RATE_LIMIT_PER_MINUTE=10

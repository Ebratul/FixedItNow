# Copy to .env (never commit .env). All values below are PLACEHOLDERS.

NODE_ENV=development
PORT=4000

# --- Database (PostgreSQL) ---------------------------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/fixeditnow_dev
# Integration tests TRUNCATE tables. Use a disposable database whose name ends
# in _test; the test runner refuses anything else.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/fixeditnow_test

# --- Auth (Better Auth) ------------------------------------------------------
# SECRET. >= 32 random characters: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-chars
# PUBLIC origin of the web app (the web app proxies /api/v1/* to this service),
# so cookies are first-party and OAuth/email links point at the web app.
BETTER_AUTH_URL=http://localhost:3000
FRONTEND_ORIGIN=http://localhost:3000

# --- Google OAuth (optional; set both or neither) ----------------------------
# GOOGLE_CLIENT_ID is public-ish; GOOGLE_CLIENT_SECRET is SECRET.
# Redirect URI to register: <BETTER_AUTH_URL>/api/v1/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email -------------------------------------------------------------------
# development default: "console" (prints links to this terminal; refused in production)
# production: "smtp" (required)
MAIL_TRANSPORT=console
EMAIL_FROM="FixedItNow <no-reply@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
# SECRET
SMTP_USER=
SMTP_PASS=

# --- Proxy / rate limiting ---------------------------------------------------
# Reverse-proxy hops in front of this service (used for client IP).
TRUST_PROXY=1
# Optional: comma-separated proxy IPs/CIDRs for Better Auth's X-Forwarded-For walk.
TRUSTED_PROXIES=
RATE_LIMIT_ENABLED=true

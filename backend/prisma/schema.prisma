// FixedItNow database schema.
//
// Auth tables (User, Session, Account, Verification, RateLimit) follow the
// Better Auth core schema and are managed by Better Auth at runtime. Do not
// rename their columns. Everything else is application data.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// Platform role. ADMIN can only be granted by a trusted operator process
/// (see `npm run admin:grant`), never through any public API.
enum UserRole {
  USER
  ADMIN
}

enum OnboardingStatus {
  DRAFT
  SUBMITTED
}

/// Mirrors docs/SRS.md FR-WRK-05.
enum VerificationStatus {
  NOT_SUBMITTED
  PENDING
  VERIFIED
  REJECTED
  RESUBMISSION_REQUIRED
}

enum PricingModel {
  FIXED
  HOURLY
  QUOTE
}

// ---------------------------------------------------------------------------
// Better Auth core tables
// ---------------------------------------------------------------------------

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  /// Trusted, DB-only. Not exposed to or settable by Better Auth clients.
  role UserRole @default(USER)

  sessions         Session[]
  accounts         Account[]
  customerProfile  CustomerProfile?
  workerProfile    WorkerProfile?
  reviewedWorkers  WorkerProfile[]  @relation("WorkerReviewer")
  auditLogs        AuditLog[]
  favorites        Favorite[]
  customerBookings Booking[]        @relation("CustomerBookings")
  customerPayments Payment[]        @relation("CustomerPayments")

  // Step 9: reviews, community, proposals, moderation
  reviews             Review[]          @relation("ReviewAuthor")
  moderatedReviews    Review[]          @relation("ReviewModerator")
  posts               CommunityPost[]   @relation("PostAuthor")
  moderatedPosts      CommunityPost[]   @relation("PostModerator")
  comments            PostComment[]     @relation("CommentAuthor")
  moderatedComments   PostComment[]     @relation("CommentModerator")
  reactions           PostReaction[]
  proposals           FeatureProposal[] @relation("ProposalAuthor")
  moderatedProposals  FeatureProposal[] @relation("ProposalModerator")
  respondedProposals  FeatureProposal[] @relation("ProposalResponder")
  featureVotes        FeatureVote[]
  reportsFiled        ContentReport[]   @relation("ReportReporter")
  reportsReviewed     ContentReport[]   @relation("ReportReviewer")

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  /// scrypt hash for the "credential" provider; never a plaintext password.
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([identifier])
  @@map("verification")
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rateLimit")
}

// ---------------------------------------------------------------------------
// Application data
// ---------------------------------------------------------------------------

/// Customer capability. Existence of a row = the account has onboarded as a
/// customer. Holds only data needed for the customer experience.
model CustomerProfile {
  id                String   @id @default(uuid(7))
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName       String
  /// One of the eight Bangladesh divisions; validated in the API.
  preferredDivision String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("customer_profile")
}

model ServiceCategory {
  id          String   @id @default(uuid(7))
  slug        String   @unique
  name        String
  description String
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workerServices WorkerService[]
  bookings       Booking[]

  @@map("service_category")
}

/// Worker capability. Separate from the base account so one account can hold
/// both Customer and Worker capabilities (docs/SRS.md FR-AUTH-08).
///
/// `onboardingStatus` (has the worker finished the form?) is deliberately
/// separate from `verificationStatus` (has an authorised reviewer approved
/// them?). A worker can never set the latter themselves.
model WorkerProfile {
  id               String           @id @default(uuid(7))
  userId           String           @unique
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  onboardingStatus OnboardingStatus @default(DRAFT)
  /// Furthest wizard step reached (1-5); lets the UI resume.
  onboardingStep   Int              @default(1)

  displayName     String?
  headline        String?
  bio             String?
  experienceYears Int?
  languages       String[]
  /// Bangladesh divisions the worker serves.
  serviceAreas    String[]
  submittedAt     DateTime?

  verificationStatus VerificationStatus @default(NOT_SUBMITTED)
  reviewedById       String?
  reviewedBy         User?              @relation("WorkerReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt         DateTime?
  reviewNote         String?

  // --- Public listing (Step 4) -------------------------------------------
  /// Public URL identifier, generated on first publish and then stable.
  slug             String?   @unique
  /// Set by the OWNER via publish/unpublish, and only while approved
  /// (SUBMITTED + VERIFIED) and not suspended. Null = not listed.
  publishedAt      DateTime?
  /// Set by an ADMIN only. While set, the profile is hidden everywhere public.
  suspendedAt      DateTime?
  /// Internal moderation note. Never returned by any public or owner API.
  suspensionReason String?
  /// Denormalised MIN(base price) over priced services, maintained in the same
  /// transaction as service changes. Enables indexed price filter/sort.
  startingPriceBdt Int?

  services          WorkerService[]
  favorites         Favorite[]
  availabilityRules WorkerAvailabilityRule[]
  timeOff           WorkerTimeOff[]
  bookings          Booking[]                @relation("WorkerBookings")
  reviews           Review[]
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  @@index([verificationStatus])
  @@index([publishedAt])
  @@index([startingPriceBdt])
  @@index([experienceYears])
  @@index([serviceAreas], type: Gin)
  @@map("worker_profile")
}

model WorkerService {
  id              String          @id @default(uuid(7))
  workerProfileId String
  workerProfile   WorkerProfile   @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)
  categoryId      String
  category        ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  pricingModel    PricingModel
  /// Whole taka. Null when pricingModel is QUOTE.
  basePriceBdt    Int?
  pricingNotes    String?

  @@unique([workerProfileId, categoryId])
  @@index([categoryId])
  @@map("worker_service")
}

/// A user's saved worker. One row per (user, worker); the unique constraint
/// makes adding idempotent and prevents duplicates under concurrent requests.
model Favorite {
  id              String        @id @default(uuid(7))
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  workerProfileId String
  workerProfile   WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())

  @@unique([userId, workerProfileId])
  @@index([userId, createdAt])
  @@map("favorite")
}

/// Append-only record of privileged actions (docs/SRS.md §4.12).
model AuditLog {
  id         String   @id @default(uuid(7))
  /// Null when performed by an operator script rather than a signed-in user.
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  targetType String
  targetId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@index([actorId])
  @@map("audit_log")
}

// ---------------------------------------------------------------------------
// Bookings (Step 5)
//
// Money is whole BDT (integer), matching worker pricing. Instants are stored in
// UTC; weekly availability is interpreted in Asia/Dhaka (see docs/BOOKINGS.md).
// Constraints Prisma cannot model (exclusion constraint, partial unique
// indexes, CHECKs) live in the migration SQL: see
// prisma/migrations/*_step5_bookings/migration.sql
// ---------------------------------------------------------------------------

enum BookingStatus {
  REQUESTED
  QUOTED
  CONFIRMED
  IN_PROGRESS
  COMPLETION_PENDING
  COMPLETED
  CANCELLED
  DECLINED
  EXPIRED
  DISPUTED
}

enum QuoteStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
  EXPIRED
}

enum RescheduleStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
  EXPIRED
}

enum ActorRole {
  CUSTOMER
  WORKER
  ADMIN
  SYSTEM
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  WAITING_FOR_INFORMATION
  RESOLVED
  REJECTED
  CLOSED
}

enum DisputeCategory {
  SERVICE_QUALITY
  NO_SHOW
  PRICE_DISAGREEMENT
  CONDUCT
  OTHER
}

/// What an admin decision does to the booking.
enum DisputeOutcome {
  MARK_COMPLETED
  CANCEL_BOOKING
  RESTORE_BOOKING
}

/// Weekly working window in Asia/Dhaka local time. weekday 0 = Sunday.
/// Minutes are since local midnight; endMinute 1440 = end of day.
model WorkerAvailabilityRule {
  id              String        @id @default(uuid(7))
  workerProfileId String
  workerProfile   WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)
  weekday         Int
  startMinute     Int
  endMinute       Int
  createdAt       DateTime      @default(now())

  @@index([workerProfileId, weekday])
  @@map("worker_availability_rule")
}

/// An unavailable instant range (leave, holiday). [startAt, endAt)
model WorkerTimeOff {
  id              String        @id @default(uuid(7))
  workerProfileId String
  workerProfile   WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)
  startAt         DateTime
  endAt           DateTime
  /// Private to the worker.
  note            String?
  createdAt       DateTime      @default(now())

  @@index([workerProfileId, startAt])
  @@map("worker_time_off")
}

model Booking {
  id              String          @id @default(uuid(7))
  customerId      String
  customer        User            @relation("CustomerBookings", fields: [customerId], references: [id], onDelete: Restrict)
  workerProfileId String
  workerProfile   WorkerProfile   @relation("WorkerBookings", fields: [workerProfileId], references: [id], onDelete: Restrict)
  categoryId      String
  category        ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  status          BookingStatus   @default(REQUESTED)

  description    String
  serviceArea    String
  serviceAddress String

  /// Appointment window [startAt, endAt). The ONLY schedule columns: a
  /// reschedule updates them; the previous values are kept in reschedule_request.
  startAt         DateTime
  endAt           DateTime
  durationMinutes Int
  timezone        String   @default("Asia/Dhaka")

  /// Snapshot at request time so later profile edits cannot rewrite history.
  pricingModel    PricingModel
  unitPriceBdt    Int?
  pricingSnapshot Json
  currency        String       @default("BDT")
  /// Set at confirmation from server-side data only (fixed/hourly rate or accepted quote).
  agreedAmountBdt Int?
  acceptedQuoteId String?      @unique

  confirmedAt           DateTime?
  startedAt             DateTime?
  completionRequestedAt DateTime?
  completedAt           DateTime?
  cancelledAt           DateTime?
  cancelledByUserId     String?
  cancellationReason    String?

  /// Client-supplied key making creation safe to retry.
  idempotencyKey String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  quotes             Quote[]
  events             BookingEvent[]
  rescheduleRequests RescheduleRequest[]
  dispute            Dispute?
  payments           Payment[]
  review             Review?

  @@unique([customerId, idempotencyKey])
  @@index([customerId, createdAt])
  @@index([workerProfileId, status, startAt])
  @@map("booking")
}

/// Append-only history and audit trail for a booking.
model BookingEvent {
  id          String         @id @default(uuid(7))
  bookingId   String
  booking     Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  actorUserId String?
  actorRole   ActorRole
  type        String
  fromStatus  BookingStatus?
  toStatus    BookingStatus?
  reason      String?
  metadata    Json?
  createdAt   DateTime       @default(now())

  @@index([bookingId, createdAt])
  @@map("booking_event")
}

model Quote {
  id                       String      @id @default(uuid(7))
  bookingId                String
  booking                  Booking     @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  status                   QuoteStatus @default(PENDING)
  laborBdt                 Int
  materialsBdt             Int         @default(0)
  otherBdt                 Int         @default(0)
  /// Always computed by the server as labor + materials + other.
  totalBdt                 Int
  currency                 String      @default("BDT")
  description              String
  terms                    String?
  estimatedDurationMinutes Int?
  expiresAt                DateTime
  createdByUserId          String
  decidedAt                DateTime?
  createdAt                DateTime    @default(now())

  @@index([bookingId, createdAt])
  @@map("quote")
}

model RescheduleRequest {
  id                String           @id @default(uuid(7))
  bookingId         String
  booking           Booking          @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  requestedByUserId String
  requestedByRole   ActorRole
  /// Appointment window when the request was made.
  previousStartAt   DateTime
  previousEndAt     DateTime
  newStartAt        DateTime
  newEndAt          DateTime
  reason            String?
  status            RescheduleStatus @default(PENDING)
  expiresAt         DateTime
  decidedByUserId   String?
  decidedAt         DateTime?
  createdAt         DateTime         @default(now())

  @@index([bookingId, createdAt])
  @@map("reschedule_request")
}

model Dispute {
  id                    String          @id @default(uuid(7))
  /// One dispute per booking.
  bookingId             String          @unique
  booking               Booking         @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  openedByUserId        String
  openedByRole          ActorRole
  category              DisputeCategory
  description           String
  status                DisputeStatus   @default(OPEN)
  /// Booking status before the dispute, used by RESTORE_BOOKING.
  previousBookingStatus BookingStatus
  assignedAdminId       String?
  outcome               DisputeOutcome?
  /// Visible to both parties.
  resolution            String?
  resolvedByUserId      String?
  resolvedAt            DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  messages DisputeMessage[]

  @@index([status, createdAt])
  @@map("dispute")
}

/// Text-only communication on a dispute. `internal` messages are admin-only.
/// (No file evidence yet: there is no private upload infrastructure.)
model DisputeMessage {
  id           String    @id @default(uuid(7))
  disputeId    String
  dispute      Dispute   @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  authorUserId String
  authorRole   ActorRole
  body         String
  internal     Boolean   @default(false)
  createdAt    DateTime  @default(now())

  @@index([disputeId, createdAt])
  @@map("dispute_message")
}

// ---------------------------------------------------------------------------
// Payments (Step 6)
//
// Money is whole BDT (integer), like bookings. A payment row is ONE attempt to
// pay a booking through ONE provider. Its status only ever becomes SUCCEEDED
// after the backend verified the transaction with the provider (never from a
// redirect or client input). Constraints Prisma cannot model (partial unique
// indexes, CHECKs, the append-only trigger) live in
// prisma/migrations/*_step6_payments/migration.sql. See docs/PAYMENTS.md.
// ---------------------------------------------------------------------------

enum PaymentProvider {
  BKASH
  SSLCOMMERZ
}

enum PaymentStatus {
  /// Row created; the provider has not been called yet (or the call has not been recorded).
  PENDING
  /// Provider session created; waiting for the customer to pay.
  INITIATED
  /// Callback received / outcome not yet verified (or ambiguous).
  PROCESSING
  /// Verified with the provider: amount, currency and reference matched.
  SUCCEEDED
  FAILED
  CANCELLED
  EXPIRED
  /// The provider reports money moved but the platform could not accept it
  /// automatically (mismatch, duplicate payment, provider risk flag).
  REQUIRES_REVIEW
  PARTIALLY_REFUNDED
  REFUNDED
}

enum PaymentReviewReason {
  AMOUNT_MISMATCH
  CURRENCY_MISMATCH
  REFERENCE_MISMATCH
  DUPLICATE_PAYMENT
  PROVIDER_RISK_FLAG
  /// Paid successfully, but the booking was no longer payable (cancelled, disputed...).
  BOOKING_INELIGIBLE
}

enum RefundStatus {
  REQUESTED
  APPROVED
  PROCESSING
  SUCCEEDED
  FAILED
  REJECTED
}

model Payment {
  id        String @id @default(uuid(7))
  /// Opaque public reference (also the provider-facing transaction id). Not the primary key.
  reference String @unique

  bookingId  String
  booking    Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  customerId String
  customer   User    @relation("CustomerPayments", fields: [customerId], references: [id], onDelete: Restrict)

  provider  PaymentProvider
  /// Sandbox vs live, fixed when the attempt is created.
  isLive    Boolean         @default(false)
  status    PaymentStatus   @default(PENDING)
  amountBdt Int
  currency  String          @default("BDT")
  /// Sum of provider-confirmed refunds only.
  refundedAmountBdt Int     @default(0)

  idempotencyKey        String?
  /// bKash paymentId / SSLCOMMERZ session key.
  providerPaymentId     String?
  /// bKash trxId / SSLCOMMERZ bank_tran_id (needed for refunds).
  providerTransactionId String?
  /// SSLCOMMERZ val_id.
  providerValidationId  String?
  checkoutUrl           String?
  failureCode           String?
  reviewReason          PaymentReviewReason?

  initiatedAt          DateTime?
  callbackReceivedAt   DateTime?
  /// bKash allows ONE execute call per paymentId; set by whoever claims it.
  executeStartedAt     DateTime?
  lastVerifiedAt       DateTime?
  verificationAttempts Int       @default(0)
  succeededAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  events  PaymentEvent[]
  refunds Refund[]

  @@unique([customerId, idempotencyKey])
  @@unique([provider, providerPaymentId])
  @@unique([provider, providerTransactionId])
  @@index([bookingId, createdAt])
  @@index([customerId, createdAt])
  @@index([status, createdAt])
  @@map("payment")
}

/// Append-only financial history. UPDATE and DELETE are rejected by a trigger.
model PaymentEvent {
  id          String         @id @default(uuid(7))
  paymentId   String
  payment     Payment        @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  refundId    String?
  type        String
  fromStatus  PaymentStatus?
  toStatus    PaymentStatus?
  actorUserId String?
  actorRole   ActorRole
  /// Makes recording the same fact twice impossible (replayed callbacks).
  dedupeKey   String?        @unique
  /// Sanitised: never credentials, tokens, card data or raw provider payloads.
  metadata    Json?
  createdAt   DateTime       @default(now())

  @@index([paymentId, createdAt])
  @@map("payment_event")
}

model Refund {
  id        String  @id @default(uuid(7))
  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  requestedByUserId  String
  requestedByRole    ActorRole
  requestedAmountBdt Int
  approvedAmountBdt  Int?
  reason             String
  status             RefundStatus @default(REQUESTED)

  decidedByUserId String?
  decidedAt       DateTime?
  decisionNote    String?

  /// Our unique id for this refund, sent to the provider where it takes one.
  providerRefundReference String  @unique
  /// Provider's refund id (SSLCOMMERZ refund_ref_id / bKash refundTrxId), once known.
  providerRefundId        String?
  failureCode             String?
  processStartedAt        DateTime?
  lastVerifiedAt          DateTime?
  completedAt             DateTime?

  idempotencyKey String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([requestedByUserId, idempotencyKey])
  @@index([paymentId, createdAt])
  @@index([status, createdAt])
  @@map("refund")
}

// ---------------------------------------------------------------------------
// Step 9: reviews, community, feature proposals, reports (docs/AI.md is Step 8)
// ---------------------------------------------------------------------------

/// Visibility of user-generated content. HIDDEN is set only by an administrator
/// (with a reason) and is reversible; DELETED is set only by the author and is final.
enum ContentStatus {
  VISIBLE
  HIDDEN
  DELETED
}

enum ReactionType {
  LIKE
}

enum ProposalStatus {
  SUBMITTED
  UNDER_REVIEW
  ACCEPTED
  DECLINED
  PLANNED
  COMPLETED
}

enum ReportTargetType {
  POST
  COMMENT
  REVIEW
  PROPOSAL
}

enum ReportReason {
  SPAM
  ABUSE
  FRAUD
  INAPPROPRIATE
  PRIVACY
  OTHER
}

enum ReportStatus {
  OPEN
  REVIEWING
  ACTIONED
  DISMISSED
}

/// One review per booking (unique bookingId). It counts toward a worker's rating
/// only while status = VISIBLE AND the booking is COMPLETED (see reviews/ratings.ts).
/// CHECK constraints (rating range, lengths, moderation coherence) live in the migration SQL.
model Review {
  id              String        @id @default(uuid(7))
  bookingId       String        @unique
  booking         Booking       @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  customerId      String
  customer        User          @relation("ReviewAuthor", fields: [customerId], references: [id], onDelete: Restrict)
  workerProfileId String
  workerProfile   WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Restrict)
  rating          Int
  comment         String?
  status          ContentStatus @default(VISIBLE)
  /// Admin moderation (HIDDEN). The reason is internal and never public.
  moderatedById   String?
  moderatedBy     User?         @relation("ReviewModerator", fields: [moderatedById], references: [id], onDelete: SetNull)
  moderatedAt     DateTime?
  moderationReason String?
  editedAt        DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  revisions ReviewRevision[]
  reports   ContentReport[]

  @@index([workerProfileId, status, createdAt])
  @@index([customerId, createdAt])
  @@map("review")
}

/// What a review said before each edit (append-only by convention; admin-visible only).
model ReviewRevision {
  id        String   @id @default(uuid(7))
  reviewId  String
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Restrict)
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  @@index([reviewId, createdAt])
  @@map("review_revision")
}

model CommunityPost {
  id               String        @id @default(uuid(7))
  authorId         String
  author           User          @relation("PostAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  title            String
  body             String
  status           ContentStatus @default(VISIBLE)
  moderatedById    String?
  moderatedBy      User?         @relation("PostModerator", fields: [moderatedById], references: [id], onDelete: SetNull)
  moderatedAt      DateTime?
  moderationReason String?
  editedAt         DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  comments  PostComment[]
  reactions PostReaction[]
  reports   ContentReport[]

  @@index([status, createdAt(sort: Desc), id])
  @@index([authorId, createdAt])
  @@map("community_post")
}

/// Flat (one level) on purpose: nested threads are not in the SRS.
model PostComment {
  id               String        @id @default(uuid(7))
  postId           String
  post             CommunityPost @relation(fields: [postId], references: [id], onDelete: Restrict)
  authorId         String
  author           User          @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  body             String
  status           ContentStatus @default(VISIBLE)
  moderatedById    String?
  moderatedBy      User?         @relation("CommentModerator", fields: [moderatedById], references: [id], onDelete: SetNull)
  moderatedAt      DateTime?
  moderationReason String?
  editedAt         DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  reports ContentReport[]

  @@index([postId, status, createdAt, id])
  @@index([authorId, createdAt])
  @@map("post_comment")
}

model PostReaction {
  id        String        @id @default(uuid(7))
  postId    String
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      ReactionType  @default(LIKE)
  createdAt DateTime      @default(now())

  /// Duplicate reactions are impossible, even under concurrent requests.
  @@unique([postId, userId, type])
  @@index([userId])
  @@map("post_reaction")
}

model FeatureProposal {
  id               String         @id @default(uuid(7))
  authorId         String
  author           User           @relation("ProposalAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  title            String
  description      String
  /// Decision lifecycle (admin only): see docs/COMMUNITY.md.
  status           ProposalStatus @default(SUBMITTED)
  /// Public admin response (required when declining).
  responseNote     String?
  respondedById    String?
  respondedBy      User?          @relation("ProposalResponder", fields: [respondedById], references: [id], onDelete: SetNull)
  respondedAt      DateTime?
  /// Content moderation, independent of the decision above.
  visibility       ContentStatus  @default(VISIBLE)
  moderatedById    String?
  moderatedBy      User?          @relation("ProposalModerator", fields: [moderatedById], references: [id], onDelete: SetNull)
  moderatedAt      DateTime?
  moderationReason String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  votes   FeatureVote[]
  reports ContentReport[]

  @@index([visibility, status, createdAt(sort: Desc), id])
  @@index([authorId, createdAt])
  @@map("feature_proposal")
}

model FeatureVote {
  id         String          @id @default(uuid(7))
  proposalId String
  proposal   FeatureProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime        @default(now())

  /// One vote per user per proposal, enforced by the database.
  @@unique([proposalId, userId])
  @@index([userId])
  @@map("feature_vote")
}

/// A report about one piece of content. Exactly one target column is set and it
/// must match targetType (CHECK in the migration). `targetKey` ("POST:<id>")
/// makes (reporter, target) unique, so a user cannot report the same item twice.
/// Reporting never hides anything: only a moderation action changes visibility.
model ContentReport {
  id             String           @id @default(uuid(7))
  reporterId     String
  reporter       User             @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  targetType     ReportTargetType
  targetKey      String
  postId         String?
  post           CommunityPost?   @relation(fields: [postId], references: [id], onDelete: Restrict)
  commentId      String?
  comment        PostComment?     @relation(fields: [commentId], references: [id], onDelete: Restrict)
  reviewId       String?
  review         Review?          @relation(fields: [reviewId], references: [id], onDelete: Restrict)
  proposalId     String?
  proposal       FeatureProposal? @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  reason         ReportReason
  details        String?
  status         ReportStatus     @default(OPEN)
  reviewedById   String?
  reviewedBy     User?            @relation("ReportReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  decisionNote   String?
  resolvedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([reporterId, targetKey])
  @@index([status, createdAt, id])
  @@index([targetType, status])
  @@index([postId])
  @@index([commentId])
  @@index([reviewId])
  @@index([proposalId])
  @@map("content_report")
}

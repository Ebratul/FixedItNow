# Public origin of the deployed site, without a trailing slash.
# Leave unset until the production domain is known: when set, it enables
# absolute Open Graph URLs, the sitemap, and the robots sitemap line.
NEXT_PUBLIC_SITE_URL=

# Where the Next.js server proxies /api/v1/* (server-side only; not exposed to
# the browser). In production, point this at the private/internal backend URL.
BACKEND_URL=http://localhost:4000
# On Vercel: set both in Project Settings -> Environment Variables (Root Directory = frontend).
# BACKEND_URL is read at BUILD time (baked into the rewrite); redeploy after changing it.
# No auth secret belongs in this file or in any NEXT_PUBLIC_* variable; see docs/AUTH.md.

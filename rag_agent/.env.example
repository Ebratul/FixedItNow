# Copy to .env (never commit .env). All values below are PLACEHOLDERS.
# Names only: a filled-in example does not mean anything is configured.

APP_ENV=development
AI_HOST=127.0.0.1
AI_PORT=8000

# --- Trust between the main API and this service -----------------------------
# Two DIFFERENT random secrets, each >= 32 chars (openssl rand -base64 48).
# AI_SERVICE_TOKEN: the main API presents it to call this service.
# APP_API_SERVICE_TOKEN: this service presents it to the main API's internal
#   AI endpoints (the main API must have the same value).
AI_SERVICE_TOKEN=
APP_API_SERVICE_TOKEN=
# Main API base URL, including /api/v1. Only /internal/ai/* is ever called.
APP_API_BASE_URL=http://localhost:4000/api/v1

# --- OpenRouter (optional: without it the service runs in heuristic mode) ----
# SECRET. Server-side only.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# No default on purpose: pick a model that supports the response format below.
OPENROUTER_MODEL=
# json_schema (strict structured outputs) | json_object | none (prompt-only JSON)
OPENROUTER_RESPONSE_FORMAT=json_schema
# Optional attribution headers OpenRouter documents
OPENROUTER_APP_URL=
OPENROUTER_APP_TITLE=FixedItNow

# --- Limits ------------------------------------------------------------------
AI_REQUEST_TIMEOUT_SECONDS=30
AI_MAX_OUTPUT_TOKENS=1200
AI_RATE_LIMIT_PER_MINUTE=10
AI_MAX_RESULTS=5
AI_MAX_CONCURRENT_REQUESTS=8

# --- Knowledge base ----------------------------------------------------------
# Defaults to ./knowledge next to this file.
AI_KNOWLEDGE_DIR=
# Where the knowledge comes from:
#   files (default): the knowledge/*.md shipped with this service.
#   api: documents that administrators publish in the admin panel (served by the main API, published only).
#        Loaded at start-up (falls back to the files if the API is unreachable) and on demand when an admin
#        presses "Sync now" (POST /v1/knowledge/reload, service token required).
AI_KNOWLEDGE_SOURCE=files
